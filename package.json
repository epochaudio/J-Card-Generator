{
  "name": "tape-cover-generator",
  "description": "A desktop application designed for cassette collectors and DIY enthusiasts to generate professional J-Card covers.",
  "author": "epochaudio",
  "private": true,
  "version": "2.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "verify:fonts": "node scripts/verify-font-assets.mjs",
    "prebuild": "npm run verify:fonts",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "node scripts/build-desktop.mjs all",
    "electron:build:mac-arm64:dmg": "node scripts/build-desktop.mjs mac-arm64",
    "electron:build:win-x64": "node scripts/build-desktop.mjs win-x64"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.2",
    "lucide-react": "^0.477.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@vitejs/plugin-react": "^4.3.1",
    "7zip-bin": "5.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.tapecover.generator",
    "productName": "TapeFolio",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "electron/**/*",
      "src/project/projectFormat.mjs",
      "src/config/design.mjs",
      "src/config/textStyles.mjs",
      "src/assets/fonts/NotoSerifSC-OFL.txt",
      "src/assets/fonts/LongCang-OFL.txt",
      "src/assets/fonts/GlowSans-OFL.txt",
      "src/assets/fonts/ChillGSans-OFL.txt",
      "src/assets/fonts/ZCOOL-OFL.txt",
      "src/ai/providerConfig.mjs",
      "src/ai/providerAPI.mjs",
      "src/ai/modelCatalog.mjs",
      "src/utils/formatDuration.mjs",
      "src/musicbrainz/projectMetadata.mjs"
    ],
    "mac": {
      "minimumSystemVersion": "13.0",
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
